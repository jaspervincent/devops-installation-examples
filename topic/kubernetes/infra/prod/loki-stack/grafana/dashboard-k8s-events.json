{
  "uid": "loki-k8s-events",
  "title": "Kubernetes 事件",
  "description": "集群事件（OOMKilled / 调度失败 / 镜像拉取失败 / 探针失败等）。事件不在容器日志里，且 etcd 中只保留 1 小时，收进 Loki 才能事后追溯。采集端见 README 步骤 4b。",
  "tags": [
    "loki",
    "logs",
    "kubernetes",
    "events"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 0,
  "refresh": "1m",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "项目",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "efzm3ndgkowsga"
        },
        "query": {
          "label": "project",
          "refId": "project",
          "type": 1
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "sort": 1,
        "description": "",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "environment",
        "label": "环境",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "efzm3ndgkowsga"
        },
        "query": {
          "label": "environment",
          "refId": "environment",
          "type": 1,
          "stream": "{project=~\"$project\"}"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "sort": 1,
        "description": "",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "namespace",
        "label": "命名空间",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "efzm3ndgkowsga"
        },
        "query": {
          "label": "namespace",
          "refId": "namespace",
          "type": 1,
          "stream": "{project=~\"$project\", environment=~\"$environment\", source=\"kubernetes-events\"}"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "sort": 1,
        "description": "_cluster 表示集群级对象（Node/PV 等）的事件",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "level",
        "label": "级别",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "efzm3ndgkowsga"
        },
        "query": {
          "label": "level",
          "refId": "level",
          "type": 1,
          "stream": "{project=~\"$project\", environment=~\"$environment\", source=\"kubernetes-events\", namespace=~\"$namespace\"}"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "sort": 1,
        "description": "warn = 事件的 type=Warning，info = Normal",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "reason",
        "label": "原因",
        "type": "textbox",
        "query": ".+",
        "current": {
          "text": ".+",
          "value": ".+"
        },
        "description": "按 reason 过滤，正则。例：FailedScheduling|Unhealthy。reason 是 logfmt 字段不是标签，所以只能手填。默认 .+ 匹配全部"
      },
      {
        "name": "kind",
        "label": "对象类型",
        "type": "textbox",
        "query": ".+",
        "current": {
          "text": ".+",
          "value": ".+"
        },
        "description": "按涉及对象的 kind 过滤，正则。例：Pod|Node|Deployment。默认 .+ 匹配全部"
      },
      {
        "name": "search",
        "label": "关键字",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "在事件正文里搜索，留空则不过滤"
      },
      {
        "name": "rate_window",
        "label": "速率窗口",
        "type": "interval",
        "query": "1m,5m,15m,1h,6h",
        "auto": false,
        "refresh": 0,
        "current": {
          "selected": true,
          "text": "5m",
          "value": "5m"
        },
        "options": [
          {
            "selected": false,
            "text": "1m",
            "value": "1m"
          },
          {
            "selected": true,
            "text": "5m",
            "value": "5m"
          },
          {
            "selected": false,
            "text": "15m",
            "value": "15m"
          },
          {
            "selected": false,
            "text": "1h",
            "value": "1h"
          },
          {
            "selected": false,
            "text": "6h",
            "value": "6h"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Warning 事件数",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "efzm3ndgkowsga"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "efzm3ndgkowsga"
          },
          "expr": "sum(count_over_time({project=~\"$project\", environment=~\"$environment\", source=\"kubernetes-events\", namespace=~\"$namespace\", level=\"warn\"} | logfmt | reason =~ \"$reason\" | kind =~ \"$kind\" |= \"$search\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "warning"
        }
      ],
      "description": "仪表盘时间范围内 type=Warning 的事件条数。不受顶部「级别」下拉影响。**刻意不做阈值着色**：这个数随时间范围线性变化（30m 和 24h 差两个数量级），任何固定阈值在用户改范围时都会失真，要么天天飘红要么永远不亮。要「超过多少就告警」用 ruler 规则（带固定时间窗），别用面板颜色，见坑位 19。空结果显示 0 而不是 No data——「没有 Warning」和「采集断了」必须能区分开。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "title": "受影响对象",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "efzm3ndgkowsga"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "efzm3ndgkowsga"
          },
          "expr": "count(sum by (name) (count_over_time({project=~\"$project\", environment=~\"$environment\", source=\"kubernetes-events\", namespace=~\"$namespace\", level=\"warn\"} | logfmt | reason =~ \"$reason\" | kind =~ \"$kind\" |= \"$search\" [$__range])))",
          "queryType": "instant",
          "legendFormat": "对象数"
        }
      ],
      "description": "有 Warning 事件的对象个数，按 name 去重。和左边一起看：事件数高但对象数只有一两个，通常是单点反复抖动，不是面上的问题。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "title": "最频繁故障原因",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "efzm3ndgkowsga"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "efzm3ndgkowsga"
          },
          "expr": "topk(1, sum by (reason) (count_over_time({project=~\"$project\", environment=~\"$environment\", source=\"kubernetes-events\", namespace=~\"$namespace\", level=\"warn\"} | logfmt | reason =~ \"$reason\" | kind =~ \"$kind\" |= \"$search\" [$__range])))",
          "queryType": "range",
          "legendFormat": "{{reason}}"
        }
      ],
      "description": "Warning 里出现次数最多的 reason，直接显示名字而不是数值。完整分布看下面的汇总表。这里用 range 查询不是 instant——instant 下 stat 显示成 Value #A，见 stat_text()。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "title": "事件趋势（Normal / Warning）",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "efzm3ndgkowsga"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "efzm3ndgkowsga"
          },
          "expr": "sum by (level) (count_over_time({project=~\"$project\", environment=~\"$environment\", source=\"kubernetes-events\", namespace=~\"$namespace\"} | logfmt | reason =~ \"$reason\" | kind =~ \"$kind\" |= \"$search\" [$__interval]))",
          "queryType": "range",
          "legendFormat": "{{level}}"
        }
      ],
      "description": "按级别堆叠的事件条数直方图，分桶宽度自动跟随视图。不受顶部「级别」下拉影响——它本身就是按级别分组的，再被收窄就只剩一种颜色。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "5m"
    },
    {
      "id": 5,
      "title": "Warning 事件汇总",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "efzm3ndgkowsga"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "efzm3ndgkowsga"
          },
          "expr": "topk(30, sum by (reason, kind, namespace) (count_over_time({project=~\"$project\", environment=~\"$environment\", source=\"kubernetes-events\", namespace=~\"$namespace\", level=\"warn\"} | logfmt | reason =~ \"$reason\" | kind =~ \"$kind\" |= \"$search\" [$__range])))",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "efzm3ndgkowsga"
          },
          "expr": "count by (reason, kind, namespace) (sum by (reason, kind, namespace, name) (count_over_time({project=~\"$project\", environment=~\"$environment\", source=\"kubernetes-events\", namespace=~\"$namespace\", level=\"warn\"} | logfmt | reason =~ \"$reason\" | kind =~ \"$kind\" |= \"$search\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "description": "排障从这里开始：哪一类原因、什么对象类型、哪个命名空间，各多少次、涉及多少个对象。**「对象数」补的是影响面**：231 次 / 32 个对象是面上的问题，8 次 / 1 个对象是单点抖动，光看次数分不出来。按 reason+kind+namespace 聚合而**不带对象名**——带上会让一次探针抖动炸成几十行；具体是哪个对象去下面的事件流看。最多 30 行。这张表取代了原先四个写死 reason 的「常见故障速查」面板，新出现的故障类型会自动进来，不用改脚本。",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "次数"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "fieldMinMax",
                "value": true
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlPu"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "对象数"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "noValue",
                "value": "—"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "原因"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "类型"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "命名空间"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Time": 0,
              "reason": 1,
              "kind": 2,
              "namespace": 3,
              "Value #A": 4,
              "Value #B": 5
            },
            "renameByName": {
              "reason": "原因",
              "kind": "类型",
              "namespace": "命名空间",
              "Value #A": "次数",
              "Value #B": "对象数"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "次数",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Warning 事件流",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "efzm3ndgkowsga"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "efzm3ndgkowsga"
          },
          "expr": "{project=~\"$project\", environment=~\"$environment\", source=\"kubernetes-events\", namespace=~\"$namespace\", level=\"warn\"} | logfmt | reason =~ \"$reason\" | kind =~ \"$kind\" |= \"$search\" | line_format `{{.reason}}  {{.kind}}/{{.name}}  [{{.namespace}}]  {{.msg}}`",
          "queryType": "range"
        }
      ],
      "description": "Warning 事件原文，已用 line_format 重排成「原因 类型/对象 [命名空间] 说明」。原始行里 objectAPIversion / objectRV / eventRV / reportinginstance 这些字段对人没用却占掉一半行宽，把真正要看的挤到了行尾。点单条左侧箭头展开，logfmt 解析出的字段（reason / kind / name / reportingcontroller / msg）都在详情里，可直接点击做过滤。",
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 200,
      "type": "row",
